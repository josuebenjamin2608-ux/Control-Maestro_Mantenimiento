# Conexión POOLED a PostgreSQL (a través de un connection pooler, ej.
# PgBouncer). La usa el cliente de Prisma en runtime (src/lib/db.ts) —
# es la que debe usar la aplicación desplegada.
# Formato estándar:
# postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE_DE_DATOS?schema=public
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/control_maestro_mantenimiento?schema=public"

# Conexión DIRECTA (sin pooler) a la misma base de datos. La usa Prisma
# CLI (prisma7.config.ts) para `migrate deploy`, `migrate dev` y `studio`:
# el motor de migraciones puede fallar sobre una conexión pooled. En
# desarrollo local con una sola base sin distinción pooled/directa puede
# ser idéntica a DATABASE_URL.
#
# Con proveedores serverless (ej. Neon), el cómputo puede estar suspendido
# y tardar unos segundos en reactivarse en la primera conexión — se
# recomienda agregar `?connect_timeout=30` al final de esta URL (o
# `&connect_timeout=30` si ya tiene otros parámetros) para tolerar ese
# arranque en frío durante `migrate deploy`.
DIRECT_URL="postgresql://usuario:contrasena@localhost:5432/control_maestro_mantenimiento?schema=public&connect_timeout=30"

# Feature flag de la integración SIMI → Vento AI (ver src/server/services/
# vento.service.ts). Deshabilitada por defecto (ausente, vacía, o cualquier
# valor distinto de la cadena exacta "true") — limpieza controlada mientras
# Telegram queda como único canal externo activo. El código y las pruebas de
# Vento permanecen intactos para poder reactivarla más adelante solo
# cambiando esta variable a "true" (y configurando
# VENTO_MAINTENANCE_REQUEST_CREATED_URL abajo).
VENTO_ENABLED=false

# Webhook de la integración SIMI → Vento AI (evento maintenance_request.created,
# ver src/server/services/vento.service.ts). Server-only: nunca se expone al
# navegador (nunca usar el prefijo NEXT_PUBLIC_ para esta variable) ni se
# hardcodea en el código. Solo se usa cuando VENTO_ENABLED="true"; si se deja
# sin definir en ese caso, el evento simplemente se omite (se registra una
# advertencia) — la importación de Solicitudes sigue funcionando con
# normalidad.
VENTO_MAINTENANCE_REQUEST_CREATED_URL=""

# Notificación directa SIMI → Telegram (evento maintenance_request.created,
# ver src/server/services/telegram.service.ts) — canal adicional e
# independiente de Vento. Server-only: nunca se expone al navegador (nunca
# usar el prefijo NEXT_PUBLIC_) ni se hardcodea en el código. Si cualquiera
# de las dos falta, o el formato es inválido, la notificación simplemente se
# omite (se registra una advertencia) — la importación de Solicitudes sigue
# funcionando con normalidad.
# Token del bot, formato <bot_id>:<hash> (ej. @SIMI_Mantenimiento_bot).
TELEGRAM_BOT_TOKEN=""
# chat_id numérico del grupo destino (negativo para grupos/supergrupos).
TELEGRAM_MAINTENANCE_CHAT_ID=""
